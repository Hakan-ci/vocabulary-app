# SERVER ONLY. Copy outside the repository and supply to Supabase secrets.
OPENAI_API_KEY=
AI_PRACTICE_ENABLED=false
AI_PRACTICE_ALLOWED_USER_IDS=
AI_PRACTICE_ALLOWED_ORIGINS=http://localhost:5173
# Generate at least 32 random characters; changing this invalidates in-flight retry fingerprints.
AI_PRACTICE_HASH_KEY=
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by the Edge runtime.
